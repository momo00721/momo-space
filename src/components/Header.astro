---
const base = import.meta.env.BASE_URL;

// 把 logo 图片上传到 public/ 文件夹，改这里的路径即可
const logoPath = `${base}logo.webp`;

const navItems = [
  { label: 'Works', href: `${base}works/` },
  { label: 'Info', href: `${base}info/` },
  { label: 'Contact', href: `${base}info/#contact` },
];

const isHome = Astro.url.pathname === base || Astro.url.pathname === '/';
---

<header class="header" class:list={{ 'header-home': isHome }}>
  <a href={base} class="header-logo">
    <img src={logoPath} alt="Kakimo" class="header-logo-img" />
  </a>
  <nav class="header-nav">
    {navItems.map((item) => (
      <a href={item.href}>
        <span class="label-top">{item.label}</span>
        <span class="label-bottom" aria-hidden="true">{item.label}</span>
      </a>
    ))}
  </nav>
</header>

<style>
  .header-logo-img {
    height: 1.5rem;
    width: auto;
    display: block;
  }
</style>

<style is:global>
  .header-home {
    mix-blend-mode: difference;
    color: var(--c-accent);
  }

  .header-home .header-logo-img {
    filter: invert(1);
  }
</style>
