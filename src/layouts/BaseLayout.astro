---
import '../styles/global.css';

export interface Props {
  title: string;
  description?: string;
  ogImage?: string;
}

const {
  title,
  description = 'Workbyworks — Multidisciplinary Design Studio based in New York & Shanghai',
  ogImage = '/share.png',
} = Astro.props;

const base = import.meta.env.BASE_URL;
const siteUrl = (Astro.site?.href ?? 'https://momo00721.github.io').replace(/\/$/, '');
const fullUrl = (path: string) => `${siteUrl}${base}${path.replace(/^\//, '')}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />

    <title>{title} — Workbyworks</title>

    <!-- Open Graph -->
    <meta property="og:title" content={`${title} — Workbyworks`} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={fullUrl(ogImage)} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Workbyworks" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={`${title} — Workbyworks`} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={fullUrl(ogImage)} />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />

    <!-- JSON-LD Structured Data -->
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "ProfessionalService",
        "name": "Workbyworks",
        "description": "Multidisciplinary Design Studio based in New York & Shanghai",
        "url": {`${siteUrl}${base}`},
        "founder": [
          { "@type": "Person", "name": "Han Gao" },
          { "@type": "Person", "name": "Wenbo Yi" }
        ],
        "areaServed": ["New York", "Shanghai"]
      }
    </script>
  </head>
  <body>
    <slot />
  </body>
</html>
