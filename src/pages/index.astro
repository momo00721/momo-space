---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Banner from '../components/Banner.astro';
import ProjectCard from '../components/ProjectCard.astro';
import Marquee from '../components/Marquee.astro';
import { getFeaturedProjects, getAllProjects } from '../utils/projects';

const featured = await getFeaturedProjects();
const all = await getAllProjects();

const bannerSlides = featured.map((p) => ({
  image: `/works/banner/banner_${String(p.data.order).padStart(2, '0')}.png`,
  title: p.data.titleCn || p.data.title,
  category: p.data.category,
  client: p.data.client,
  slug: p.id,
}));

const base = import.meta.env.BASE_URL;
const firstBanner = bannerSlides[0]?.image;
const firstBannerSrc = firstBanner?.startsWith('/') ? `${base}${firstBanner.slice(1)}` : firstBanner;
---

<BaseLayout title="Home">
  {firstBannerSrc && <link rel="preload" as="image" href={firstBannerSrc} fetchpriority="high" />}
  <Header />
  <Banner slides={bannerSlides} />

  <main class="content">
    <section class="projects-grid">
      {all
        .sort((a, b) => a.data.order - b.data.order)
        .map((p) => (
          <ProjectCard
            title={p.data.title}
            category={p.data.category}
            client={p.data.client}
            slug={p.id}
            cover={p.data.cover ?? '/placeholder.svg'}
          />
        ))}
    </section>

    <Marquee text="CREATIVE DIRECTION &mdash; BRANDING &mdash; VISUAL IDENTITIES &mdash; PACKAGING &mdash; WEBSITES &mdash; BOOK DESIGN &mdash;" />
    <Footer />
  </main>
</BaseLayout>
